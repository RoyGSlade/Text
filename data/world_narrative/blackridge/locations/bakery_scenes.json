    "scene.bakery.line-captain": {
      "title": "Line Captain’s Post",
      "textBlocks": [
        {
          "text": "Corin Bale eyes the queue like a ledger he’s tired of balancing."
        }
      ],
      "choices": [
        {
          "id": "deliver-rations",
          "requires": {
            "have": [
              {
                "itemId": "item.bakery.ration-pack",
                "qty": 3
              }
            ]
          },
          "text": "Deliver ration packs to the Watch",
          "actions": [
