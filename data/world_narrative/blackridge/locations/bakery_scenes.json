    "scene.bakery.stakeout": {
      "title": "Bakery Rooftop: Stakeout",
      "textBlocks": [
        {
          "when": "!br:curfewActive",
          "text": "Daylight washes the rooftops; the glow won’t show until the dead hours."
        },
        {
          "when": "br:curfewActive",
          "text": "The eastern road hums with a low, wrong light."
        },
        {
          "text": "A chimney offers cover and a narrow angle on the road to the Gates."
        }
      ],
      "choices": [
        {
          "id": "choose-vantage",
          "text": "Pick a vantage and wait",
          "actions": [
            {
              "type": "setFlag",
              "flag": "br:bakery.vantageChosen",
              "op": "=",
              "value": true
            }
          ]
