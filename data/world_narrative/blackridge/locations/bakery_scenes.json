    "scene.bakery.counter": {
      "title": "Bakery Counter",
      "textBlocks": [
        {
          "text": "Mara Kestrel works two paddles and three conversations at once."
        }
      ],
      "choices": [
        {
          "id": "buy-snack",
          "requires": {
            "credits": 3
          },
          "text": "Buy Night-Guard Snack (3 cr)",
          "actions": [
            {
              "type": "incCredits",
              "value": -3
            },
            {
              "type": "addItem",
              "itemId": "item.bakery.snack-guard",
              "qty": 1
            }
          ]
        },
        {
          "id": "buy-ration",
          "requires": {
            "credits": 6
