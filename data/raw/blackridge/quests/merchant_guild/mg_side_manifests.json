          "completionCheck": {
            "flagsAny": [
              "br:mg.manifest.crate_found"
            ]
          }
        },
        {
          "id": "stage2_return_manifest",
          "text": "Return the manifest without alerting Dispatch.",
          "completionCheck": {
            "have": [
              {
                "itemId": "doc.convoy_manifest",
                "qty": 1
              }
            ]
          },
          "onComplete": [
            {
              "type": "incFlag",
              "flag": "br:mg.rep",
              "value": 1
            }
          ]
        }
      ],
      "rewards": [
        {
          "type": "xp",
          "amount": 60
        },
        {
          "type": "item",
          "itemId": "pass.convoy_basic",
          "qty": 1
        }
      ]
    },
    {
      "id": "mg_side_loan_shark",
      "tags": [
        "side",
        "collections",
        "morality"
      ],
      "title": "Collections Call",
      "desc": "A debtor defaulted. Retrieve coin or property. Or mercy, if your spine still works.",
      "requirements": {
        "flagsAny": [
          "br:mg.unlocked"
        ]
      },
      "stages": [
        {
          "id": "stage1_locate_debtor",
          "text": "Locate the debtor in town.",
          "completionCheck": {
            "flagsAny": [
              "br:mg.debtor.located"
            ]
          }
