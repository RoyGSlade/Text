    {
      "id": "exit-clean",
      "text": "Exit without triggering an arrest.",
      "completionCheck": {
        "flagsAny": [
          "br:heist.bakery.exfiltrated"
        ]
      },
      "rewards": [
        {
          "type": "incCredits",
          "value": 120
        },
        {
          "type": "setFlag",
          "flag": "br:merchantFixing",
          "op": "=",
          "value": true
        }
      ]
    }
