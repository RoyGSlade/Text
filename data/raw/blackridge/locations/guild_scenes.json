    "scene.guild.entry": {
      "title": "Adventurer Guild: Entry Hall",
      "textBlocks": [
        {
          "when": "br:curfewActive",
          "text": "Lanternlight smears the marble. Night dockets stack two-deep; pay doubles if you live."
        },
        {
          "text": "Queues coil. A stamping rhythm from the clerk’s desk is the closest thing to mercy."
        }
      ],
      "choices": [
        {
          "id": "to-front-desk",
          "text": "Approach the Head Clerk",
          "actions": [
            {
              "type": "setFlag",
              "flag": "br:spokeToHeadClerk",
              "op": "=",
              "value": true
            }
          ],
          "leadsTo": "scene.guild.front-desk"
        },
        {
          "id": "to-job-board",
          "text": "Check the Job Board",
          "leadsTo": "scene.guild.job-board"
        },
        {
          "id": "inspectors-window",
          "text": "Visit the Inspector’s Window",
          "leadsTo": "scene.guild.inspection"
        },
        {
          "id": "read-the-room",
          "type": "skillCheck",
          "skill": "Perception",
          "dc": 10,
          "onSuccess": "scene.guild.entry_read-the-room_success",
          "onFailure": "scene.guild.entry_read-the-room_failure",
          "text": "Read the room"
        }
      ]
    },
    "scene.guild.front-desk_upgrade-permit_failure": {
