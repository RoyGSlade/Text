        {
          "id": "stage2_resolve",
          "text": "Resolve the debt: squeeze coin, seize collateral, or forgive the debt.",
          "completionCheck": {
            "flagsAny": [
              "br:mg.debt.paid",
              "br:mg.debt.collateral",
              "br:mg.debt.forgiven"
            ]
          },
          "onComplete": [
            {
              "type": "incFlag",
              "flag": "br:mg.rep",
              "value": 1
            }
          ]
        }
      ],
      "rewards": [
        {
          "type": "xp",
          "amount": 50
        },
        {
          "type": "credits",
          "amount": 20
        }
      ]
