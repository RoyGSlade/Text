              "skill": "Melee",
              "dc": 12,
              "onSuccess": "poi:{qid}:inner",
              "onFailure": "poi:{qid}:lash"
            },
            { "text": "Retreat", "leadsTo": "{returnScene}" }
          ]
        },
        "lash": {
          "id": "poi:{qid}:lash",
          "text": "Thorns lash your arms.",
          "choices": [ { "text": "Back", "leadsTo": "poi:{qid}:entry" } ]
        },
        "inner": {
          "id": "poi:{qid}:inner",
          "text": "A fungus heart swells with sick light.",
          "choices": [
            {
              "text": "Burn heart (Science DC 13)",
              "type": "skillCheck",
              "skill": "Science",
              "dc": 13,
              "onSuccess": "poi:{qid}:cleansed",
              "onFailure": "poi:{qid}:spore"
            }
          ]
        },
        "spore": {
          "id": "poi:{qid}:spore",
          "text": "Spores choke your lungs.",
          "choices": [ { "text": "Back", "leadsTo": "poi:{qid}:inner" } ]
        },
        "cleansed": {
          "id": "poi:{qid}:cleansed",
          "text": "The heart collapses. Fresh rain falls.",
          "actions": [
            { "type": "setFlag", "flag": "dungeon:{qid}:cleansed", "value": true },
            { "type": "setFlag", "flag": "br:dungeon:jungle:heart_destroyed", "value": true },
            { "type": "setFlag", "flag": "br:beacon:jungle_halo", "value": true }
          ],
          "choices": [ { "text": "Return", "leadsTo": "{returnScene}" } ]
        }
      }
    },
    {
      "id": "heart_plains",
      "title": "Buried Cairn",
      "scenes": {
        "entry": {
          "id": "poi:{qid}:entry",
          "text": "A mound of stones hums under grass.",
          "choices": [
            { "text": "Dig down (Science DC 11)", "type": "skillCheck", "skill": "Science", "dc": 11, "onSuccess": "poi:{qid}:inner", "onFailure": "poi:{qid}:collapse" },
            { "text": "Retreat", "leadsTo": "{returnScene}" }
          ]
        },
        "collapse": {
          "id": "poi:{qid}:collapse",
          "text": "Loose stones tumble around you.",
          "choices": [ { "text": "Back", "leadsTo": "poi:{qid}:entry" } ]
        },
        "inner": {
          "id": "poi:{qid}:inner",
          "text": "A buried heart beats like distant drums.",
          "choices": [
            { "text": "Crush core (Melee DC 12)", "type": "skillCheck", "skill": "Melee", "dc": 12, "onSuccess": "poi:{qid}:cleansed", "onFailure": "poi:{qid}:rumble" }
          ]
        },
        "rumble": {
          "id": "poi:{qid}:rumble",
          "text": "The mound rumbles threateningly.",
          "choices": [ { "text": "Back", "leadsTo": "poi:{qid}:inner" } ]
        },
        "cleansed": {
          "id": "poi:{qid}:cleansed",
          "text": "The beat stops. Winds sweep the plains.",
          "actions": [
            { "type": "setFlag", "flag": "dungeon:{qid}:cleansed", "value": true },
            { "type": "setFlag", "flag": "br:dungeon:plains:heart_destroyed", "value": true },
            { "type": "setFlag", "flag": "br:recipe:plains_goulash", "value": true }
          ],
          "choices": [ { "text": "Return", "leadsTo": "{returnScene}" } ]
        }
      }
    },
