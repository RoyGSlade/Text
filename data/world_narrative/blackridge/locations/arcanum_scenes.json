    "arcanum_lab_training": {
      "title": "Radiant Drills",
      "textBlocks": [
        {
          "when": "true",
          "text": "Valentar flips the room into a testing posture. Lines of force settle like grid paper over your vision."
        }
      ],
      "choices": [
        {
          "type": "skillCheck",
          "skill": "Science",
          "dc": 17,
          "text": "Analyze a muttering filament.",
          "onSuccess": "arcanum_lab_training_choice0_success",
          "onFailure": "arcanum_lab_training_choice0_failure"
        },
        {
          "type": "skillCheck",
          "skill": "Technology",
          "dc": 18,
          "text": "Assemble an impossible junction.",
          "onSuccess": "arcanum_lab_training_choice1_success",
          "onFailure": "arcanum_lab_training_choice1_failure"
        },
        {
          "text": "End drills",
          "leadsTo": "arcanum_lab"
        }
      ]
    },
    "arcanum_trades_choice2_success": {
      "actions": [
        {
          "type": "addItem",
