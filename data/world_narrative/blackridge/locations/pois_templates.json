{
  "poiTemplates": [
    {
      "id": "heart_forest",
      "title": "Blighted Crypt",
      "scenes": {
        "entry": {
          "id": "poi:{qid}:entry",
          "text": "A hill-crypt exhales cold. Black veins pulse.",
          "choices": [
            {
              "text": "Probe wards (Science DC 13)",
              "type": "skillCheck",
              "skill": "Science",
              "dc": 13,
              "onSuccess": "poi:{qid}:inner",
              "onFailure": "poi:{qid}:ward_shock"
            },
            {
              "text": "Retreat",
              "leadsTo": "{returnScene}"
            }
          ]
        },
        "ward_shock": {
          "id": "poi:{qid}:ward_shock",
          "text": "The wards lash your fingers.",
          "choices": [
            {
              "text": "Back",
              "leadsTo": "poi:{qid}:entry"
            }
          ]
        },
        "inner": {
          "id": "poi:{qid}:inner",
          "text": "The inner seal yields. A heart-crystal thrums.",
          "choices": [
            {
              "text": "Shatter (Melee DC 12)",
              "type": "skillCheck",
              "skill": "Melee",
              "dc": 12,
              "onSuccess": "poi:{qid}:cleansed",
              "onFailure": "poi:{qid}:pulse"
            }
          ]
        },
        "pulse": {
          "id": "poi:{qid}:pulse",
          "text": "A hateful pulse throws you back.",
          "choices": [
            {
              "text": "Back",
              "leadsTo": "poi:{qid}:inner"
            }
          ]
        },
        "cleansed": {
          "id": "poi:{qid}:cleansed",
          "text": "The crystal splits. The air warms.",
          "actions": [
            {
              "type": "setFlag",
              "flag": "dungeon:{qid}:cleansed",
              "value": true
            },
            {
              "type": "setFlag",
              "flag": "br:dungeon:forest:heart_destroyed",
              "value": true
            },
            {
              "type": "setFlag",
              "flag": "br:fasttravel:forest_bridge",
              "value": true
            }
          ],
          "choices": [
            {
              "text": "Return",
              "leadsTo": "{returnScene}"
            }
          ]
        }
      }
    },
    {
      "id": "heart_desert",
      "title": "Searing Core",
      "scenes": {
        "entry": {
          "id": "poi:{qid}:entry",
          "text": "A dune cave breathes heat. Sand drips like glass.",
          "choices": [
            {
              "text": "Brush aside runes (Science DC 13)",
              "type": "skillCheck",
              "skill": "Science",
              "dc": 13,
              "onSuccess": "poi:{qid}:inner",
              "onFailure": "poi:{qid}:ward_scorch"
            },
            {
              "text": "Retreat",
              "leadsTo": "{returnScene}"
            }
          ]
        },
        "ward_scorch": {
          "id": "poi:{qid}:ward_scorch",
          "text": "Heat sigils sear your palm.",
          "choices": [
            {
              "text": "Back",
              "leadsTo": "poi:{qid}:entry"
            }
          ]
        },
        "inner": {
          "id": "poi:{qid}:inner",
          "text": "A molten heart pulses beneath glassy sand.",
          "choices": [
            {
              "text": "Smash core (Melee DC 12)",
              "type": "skillCheck",
              "skill": "Melee",
              "dc": 12,
              "onSuccess": "poi:{qid}:cleansed",
              "onFailure": "poi:{qid}:flare"
            }
          ]
        },
        "flare": {
          "id": "poi:{qid}:flare",
          "text": "A flare of sand blinds you.",
          "choices": [
            {
              "text": "Back",
              "leadsTo": "poi:{qid}:inner"
            }
          ]
        },
        "cleansed": {
          "id": "poi:{qid}:cleansed",
          "text": "The core cools to ash. Night winds sweep in.",
          "actions": [
            { "type": "setFlag", "flag": "dungeon:{qid}:cleansed", "value": true },
            { "type": "setFlag", "flag": "br:dungeon:desert:heart_destroyed", "value": true },
            { "type": "setFlag", "flag": "br:fasttravel:desert_oasis", "value": true }
          ],
          "choices": [
            { "text": "Return", "leadsTo": "{returnScene}" }
          ]
        }
      }
    },
    {
      "id": "heart_jungle",
      "title": "Rotting Canopy",
      "scenes": {
        "entry": {
          "id": "poi:{qid}:entry",
          "text": "Vines knot over a sinkhole. Rot steams up.",
          "choices": [
            {
              "text": "Cut vines (Melee DC 12)",
