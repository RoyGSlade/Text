      ]
    },
    {
      "id": "offer_smokehouse_pass",
      "label": "Ask to see the smokehouse",
      "requires": { "flagsAny": ["br:butcher.unlocked"], "flagsNot": ["br:butcher.smokehouse_access"] },
      "actions": [
        { "type": "setFlag", "flag": "br:butcher.smokehouse_access", "op": "=", "value": true },
        { "type": "gotoScene", "sceneId": "butcher_smokehouse" }
      ]
    }
  ]
