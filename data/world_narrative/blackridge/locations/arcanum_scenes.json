    "arcanum_trades": {
      "title": "Contraband Exchange",
      "textBlocks": [
        {
          "when": "true",
          "text": "“No credits,” Valentar says. “Bring me teeth, fragments, and things the Mayor wishes didn't exist.”"
        }
      ],
      "choices": [
        {
          "text": "Trade 2 Rotating Floor Fragments for Mindweave Robes",
          "requires": {
            "have": [
              {
                "itemId": "component.rotating_floor_fragment",
                "qty": 2
              }
            ]
          },
          "actions": [
            {
              "type": "removeItem",
              "itemId": "component.rotating_floor_fragment",
              "qty": 2
            },
            {
              "type": "addItem",
              "itemId": "armor.mindweave_robes",
              "qty": 1
            }
          ]
        },
        {
          "text": "Trade 3 Goblin Teeth for Phantom Sabre",
          "requires": {
            "have": [
              {
                "itemId": "reagent.goblin_teeth",
                "qty": 3
              }
            ]
          },
          "actions": [
            {
              "type": "removeItem",
              "itemId": "reagent.goblin_teeth",
              "qty": 3
            },
            {
              "type": "addItem",
              "itemId": "weapon.phantom_sabre",
              "qty": 1
            }
          ]
        },
        {
          "type": "skillCheck",
          "skill": "Barter",
          "dc": 15,
          "text": "Haggle using a sticky memory note as leverage.",
          "onSuccess": "arcanum_trades_choice2_success",
          "onFailure": "arcanum_trades_choice2_failure"
        },
        {
          "text": "Back to office",
          "leadsTo": "arcanum_office"
        }
      ]
    }
  }
