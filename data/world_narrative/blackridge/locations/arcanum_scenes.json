{
  "area": "arcanum",
  "scenes": {
    "arcanum_entry_choice1_success": {
      "actions": [
        {
          "type": "addItem",
          "itemId": "quest.note.sticky_memory_hint",
          "qty": 1
        },
        {
          "type": "setFlag",
          "flag": "br:arcanum.orientation.completed",
          "op": "=",
          "value": true
        }
      ]
    },
    "arcanum_entry_choice1_failure": {
      "actions": [
        {
          "type": "incFlag",
          "flag": "br:suspicion",
          "value": 1
        }
      ]
    },
    "arcanum_entry": {
      "title": "Arcanum Tower Threshold",
      "textBlocks": [
        {
          "when": "!br:arcanum.unlocked",
          "text": "The tower door is a rumor with hinges. Pleas for help echo from the street. The guards drag loiterers away. The key is a letter that recognizes your name."
        },
        {
          "when": "br:arcanum.unlocked",
          "text": "Inside is a fever dream: rotating floors, gravity second-guessing itself, light bulbs that argue about color temperature. Books follow you like guilt."
        }
      ],
      "choices": [
        {
          "text": "Present the pigeon-letter invitation.",
          "requires": {
            "flagsNot": [
              "br:arcanum.unlocked"
            ],
            "have": [
              {
                "itemId": "letter.arcanum_invite",
                "qty": 1
              }
            ]
          },
          "actions": [
            {
              "type": "setFlag",
              "flag": "br:arcanum.unlocked",
              "op": "=",
              "value": true
            },
            {
              "type": "incFlag",
              "flag": "br:suspicion",
              "value": 1
            },
            {
              "type": "incFlag",
              "flag": "br:rumor.arcanum_opened",
              "value": 1
            }
          ],
          "leadsTo": "arcanum_office"
        },
        {
          "type": "skillCheck",
          "skill": "Perception",
          "dc": 12,
          "text": "Catch a skittering book before it hides your memory.",
          "onSuccess": "arcanum_entry_choice1_success",
          "onFailure": "arcanum_entry_choice1_failure"
        },
        {
          "text": "Leave quietly.",
          "leadsTo": "town:blackridge"
        }
      ]
    },
    "arcanum_office_choice1_success": {
      "actions": [
        {
          "type": "incFlag",
          "flag": "br:arcanum.seer_trust",
          "value": 1
        }
      ]
    },
    "arcanum_office_choice1_failure": {
      "actions": [
        {
          "type": "incFlag",
          "flag": "br:suspicion",
          "value": 1
        }
      ]
    },
    "arcanum_office": {
      "title": "Valentar's Office",
      "textBlocks": [
        {
          "when": "true",
          "text": "Valentar calibrates a desk lamp that keeps forgetting it is a lamp. \"We won't always remember this conversation,\" he says, sticking a note to your forehead."
        },
        {
          "when": "br:arcanum.seer_trust >= 2 && !br:arcanum.path.stage2_done",
          "text": "“Do the fence task. Boredom protects futures. Unless bandits disagree.”"
        },
        {
          "when": "br:arcanum.path.stage2_done && !br:arcanum.memories.hinted",
          "text": "“My memories are lodged where they shouldn't be. Basement of City Hall. The Library stacks. Bring them.”"
        }
      ],
      "choices": [
        {
          "text": "State your intent to help.",
          "requires": {
            "flagsAny": [
              "br:arcanum.unlocked"
            ],
            "flagsNot": [
              "br:arcanum.orientation.completed"
            ]
          },
          "actions": [
            {
              "type": "setFlag",
              "flag": "br:arcanum.orientation.completed",
              "op": "=",
              "value": true
            }
          ]
        },
        {
          "type": "skillCheck",
          "skill": "Diplomacy",
          "dc": 13,
          "text": "Argue for fewer secrets.",
          "onSuccess": "arcanum_office_choice1_success",
          "onFailure": "arcanum_office_choice1_failure"
        },
        {
          "text": "Enter the lab",
          "leadsTo": "arcanum_lab"
        },
        {
          "text": "Check trades",
          "leadsTo": "arcanum_trades"
        }
      ]
    },
    "arcanum_lab_choice0_success": {
      "actions": [
        {
          "type": "addItem",
          "itemId": "component.rotating_floor_fragment",
          "qty": 1
        },
        {
          "type": "incFlag",
          "flag": "br:arcanum.seer_trust",
          "value": 1
        }
      ]
    },
    "arcanum_lab_choice0_failure": {
      "actions": [
        {
          "type": "incFlag",
          "flag": "br:suspicion",
          "value": 1
        }
      ]
    },
    "arcanum_lab_choice1_success": {
      "actions": [
        {
          "type": "addItem",
          "itemId": "blueprint.jump_boots",
          "qty": 1
        }
      ]
    },
    "arcanum_lab_choice1_failure": {
      "actions": [
        {
          "type": "setFlag",
          "flag": "br:arcanum.lab.short",
          "op": "=",
          "value": true
        }
      ]
    },
    "arcanum_lab": {
      "title": "Spectrograph Lab (No Decoding Here)",
      "textBlocks": [
        {
          "when": "true",
          "text": "Devices hum, floors rotate, and a chalkboard redraws itself to argue with your handwriting."
        }
      ],
      "choices": [
        {
          "type": "skillCheck",
          "skill": "Arcana",
          "dc": 14,
          "text": "Calibrate a stubborn lens array.",
          "onSuccess": "arcanum_lab_choice0_success",
          "onFailure": "arcanum_lab_choice0_failure"
        },
        {
          "type": "skillCheck",
          "skill": "Technology",
          "dc": 16,
          "text": "Rewire the lamp that forgets itself.",
          "onSuccess": "arcanum_lab_choice1_success",
          "onFailure": "arcanum_lab_choice1_failure"
        },
        {
          "text": "Attempt drills with Valentar",
          "requires": {
            "flagsAny": [
              "br:arcanum.training.ready"
            ]
          },
          "leadsTo": "arcanum_lab_training"
        },
        {
          "text": "Back to office",
          "leadsTo": "arcanum_office"
        }
      ]
    },
    "arcanum_lab_training_choice0_success": {
