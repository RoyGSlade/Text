          "dc": 12,
          "onSuccess": "scene.bakery.stakeout_watch-road_success",
          "onFailure": "scene.bakery.stakeout_watch-road_failure",
          "text": "Scan the road for the glowing convoy"
        },
        {
          "id": "quiet-shift",
          "type": "skillCheck",
          "skill": "Stealth",
          "dc": 11,
          "onSuccess": "scene.bakery.stakeout_quiet-shift_success",
          "onFailure": "scene.bakery.stakeout_quiet-shift_failure",
          "text": "Shift position silently"
        }
      ]
