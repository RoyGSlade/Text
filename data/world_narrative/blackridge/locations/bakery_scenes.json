    "scene.bakery.entry": {
      "title": "Warm Loaf Bakery",
      "textBlocks": [
        {
          "when": "br:curfewActive",
          "text": "The windows sweat gold. A line of Watch and civilians coils into the alley."
        },
        {
          "text": "Flour hangs in the air like a promise nobody signed."
        }
      ],
      "choices": [
        {
          "id": "to-counter",
          "text": "Approach the counter",
          "leadsTo": "scene.bakery.counter"
        },
        {
          "id": "join-breadline",
          "text": "Join the pre-dawn breadline",
          "actions": [
            {
              "type": "setFlag",
              "flag": "br:bakery.queueJoined",
              "op": "=",
              "value": true
            }
          ]
        },
        {
          "id": "read-the-room",
          "type": "skillCheck",
          "skill": "Insight",
          "dc": 10,
          "onSuccess": "scene.bakery.entry_read-the-room_success",
          "onFailure": "scene.bakery.entry_read-the-room_failure",
          "text": "Read the room"
        }
      ]
    },
