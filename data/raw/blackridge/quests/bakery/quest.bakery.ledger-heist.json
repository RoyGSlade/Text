      "text": "Case the Bakery after midnight and map patrols.",
      "completionCheck": {
        "flagsAny": [
          "br:heist.bakery.cased"
        ]
      }
    },
    {
      "id": "copy-stamp",
      "text": "Create a wax copy of the ration stamp.",
      "completionCheck": {
        "flagsAny": [
          "br:heist.bakery.stampCopied"
        ]
      }
