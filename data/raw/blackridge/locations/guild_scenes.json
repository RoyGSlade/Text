    "scene.guild.front-desk": {
      "title": "Front Desk",
      "textBlocks": [
        {
          "text": "Edrin Vale doesn’t look up. The stamp does."
        }
      ],
      "choices": [
        {
          "id": "apply-novice-permit",
          "requires": {
            "credits": 100,
            "flagsNot": [
              "br:permitTier>=1"
            ],
            "flagsAny": [
              "br:repGuildRespected",
              "br:repAlliesCount5"
            ]
          },
          "text": "Apply for Novice Permit (100 cr)",
          "actions": [
            {
              "type": "incCredits",
              "value": -100
            },
            {
              "type": "setFlag",
              "flag": "br:permitTier",
              "op": "=",
              "value": 1
            },
            {
              "type": "addItem",
              "itemId": "item.guild.permit.novice",
              "qty": 1
            }
          ]
        },
        {
          "id": "upgrade-permit",
          "requires": {
            "flagsAny": [
              "br:permitTier>=1"
            ]
          },
          "type": "skillCheck",
          "skill": "Diplomacy",
          "dc": 12,
          "onSuccess": "scene.guild.permit-upgrade",
          "onFailure": "scene.guild.front-desk_upgrade-permit_failure",
          "text": "Upgrade Permit (Advanced→Mythic; price scales x3 each tier)"
        },
        {
          "id": "clerk-briefing",
          "text": "Request briefing on legal commissions",
          "actions": [
            {
              "type": "setFlag",
              "flag": "br:tutorialGuildBriefed",
              "op": "=",
              "value": true
            }
          ]
        },
        {
          "id": "tone-check",
          "type": "skillCheck",
          "skill": "Insight",
          "dc": 11,
          "onSuccess": "scene.guild.front-desk_tone-check_success",
          "onFailure": "scene.guild.front-desk_tone-check_failure",
          "text": "Gauge the clerk’s mood"
        }
      ]
    },
